<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- can also run fine in net8.0, but: don't want triplicate by default, and don't want competition between runs -->
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>StackExchange.Redis.Tests</AssemblyName>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <SignAssembly>true</SignAssembly>
    <DebugType>full</DebugType>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- xunit.v3 4.x runs on Microsoft.Testing.Platform; global.json selects that runner for `dotnet test`, so the
         VSTest adapter packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) are no longer referenced -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- avoid parallelism on some brittle things like script-flush that *really* don't work well vs concurrent runtimes -->
    <DefineConstants Condition="'$(TargetFramework)'=='net10.0'">$(DefineConstants);BUILD_CURRENT</DefineConstants>

    <!-- xUnit1069: a Timeout on a test that does not observe TestContext.Current.CancellationToken cannot stop the
         test body, only fail it. The round-trip unit tests use Timeout as a hang guard against the in-process
         transport, where failing is all that is wanted; threading the token through them buys nothing. -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="*.json" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="*Config.json" />
    <None Update="redislabs_ca.pem" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Certificates\*.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ResultProcessorUnitTests.*.cs" DependentUpon="ResultProcessorUnitTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis\StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\toys\StackExchange.Redis.Server\StackExchange.Redis.Server.csproj" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" />
    <PackageReference Include="System.Threading.Channels" />
    <!-- SanityChecks reads the built assembly's metadata; inbox on .NET, and no longer transitive on net481 now that Microsoft.NET.Test.Sdk is gone -->
    <PackageReference Include="System.Reflection.Metadata" Condition="'$(TargetFramework)' == 'net481'" />
    <!-- `dynamic` in a few tests needs the runtime binder; also previously transitive via Microsoft.NET.Test.Sdk on net481 -->
    <Reference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'net481'" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="System.IO.Compression" />
    <PackageReference Include="System.IO.Pipelines" />
    <ProjectReference Include="..\..\src\RESPite\RESPite.csproj" />
    <ProjectReference Include="..\RESPite.Tests\RESPite.Tests.csproj" />
    <!-- to deal with package security warning -->
    <PackageReference Include="System.Private.Uri" />
  </ItemGroup>
</Project>
