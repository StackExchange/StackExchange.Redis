<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- can also run fine in net8.0, but: don't want triplicate by default, and don't want competition between runs -->
    <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>StackExchange.Redis.Tests</AssemblyName>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <SignAssembly>true</SignAssembly>
    <DebugType>full</DebugType>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- avoid parallelism on some brittle things like script-flush that *really* don't work well vs concurrent runtimes -->
    <DefineConstants Condition="'$(TargetFramework)'=='net10.0'">$(DefineConstants);BUILD_CURRENT</DefineConstants>
  </PropertyGroup>

  <!--
    PARKED, NOT DELETED: these drive the old core's ResultProcessor, PhysicalConnection, RedisDatabase or writer
    directly, which went with the old core. Their RESP inputs and expected values are worth keeping, so they are to be retargeted at the new
    core's handlers (see design/v4-alpha-plan.md, gate 3) rather than dropped. Excluded only until then.
  -->
  <ItemGroup>
    <Compile Remove="ResultProcessorUnitTests/AutoConfigure.cs" />
    <Compile Remove="ResultProcessorUnitTests/BasicAggregates.cs" />
    <Compile Remove="ResultProcessorUnitTests/BasicScalars.cs" />
    <Compile Remove="ResultProcessorUnitTests/ClientInfo.cs" />
    <Compile Remove="ResultProcessorUnitTests/ClusterNodes.cs" />
    <Compile Remove="ResultProcessorUnitTests/ConditionTests.cs" />
    <Compile Remove="ResultProcessorUnitTests/DateTime.cs" />
    <Compile Remove="ResultProcessorUnitTests/DemandZeroOrOne.cs" />
    <Compile Remove="ResultProcessorUnitTests/ExpectBasicString.cs" />
    <Compile Remove="ResultProcessorUnitTests/GeoPosition.cs" />
    <Compile Remove="ResultProcessorUnitTests/GeoRadius.cs" />
    <Compile Remove="ResultProcessorUnitTests/HotKeys.cs" />
    <Compile Remove="ResultProcessorUnitTests/Info.cs" />
    <Compile Remove="ResultProcessorUnitTests/InterleavedPairs.cs" />
    <Compile Remove="ResultProcessorUnitTests/Latency.cs" />
    <Compile Remove="ResultProcessorUnitTests/Lease.cs" />
    <Compile Remove="ResultProcessorUnitTests/LeaseRedisValue.cs" />
    <Compile Remove="ResultProcessorUnitTests/ListMoveMultiple.cs" />
    <Compile Remove="ResultProcessorUnitTests/LongestCommonSubsequence.cs" />
    <Compile Remove="ResultProcessorUnitTests/Misc.cs" />
    <Compile Remove="ResultProcessorUnitTests/RedisValueFromArray.cs" />
    <Compile Remove="ResultProcessorUnitTests/RespResultProcessor.cs" />
    <Compile Remove="ResultProcessorUnitTests/Role.cs" />
    <Compile Remove="ResultProcessorUnitTests/Scan.cs" />
    <Compile Remove="ResultProcessorUnitTests/ScriptLoad.cs" />
    <Compile Remove="ResultProcessorUnitTests/SentinelGetPrimaryAddressByName.cs" />
    <Compile Remove="ResultProcessorUnitTests/SentinelGetReplicaAddresses.cs" />
    <Compile Remove="ResultProcessorUnitTests/SentinelGetSentinelAddresses.cs" />
    <Compile Remove="ResultProcessorUnitTests/StreamAutoClaim.cs" />
    <Compile Remove="ResultProcessorUnitTests/StreamAutoClaimIdsOnly.cs" />
    <Compile Remove="ResultProcessorUnitTests/StreamInfo.cs" />
    <Compile Remove="ResultProcessorUnitTests/StreamPendingInfo.cs" />
    <Compile Remove="ResultProcessorUnitTests/StreamPendingMessages.cs" />
    <Compile Remove="ResultProcessorUnitTests/Streams.cs" />
    <Compile Remove="ResultProcessorUnitTests/TimeSpan.cs" />
    <Compile Remove="ResultProcessorUnitTests/Timing.cs" />
    <Compile Remove="ResultProcessorUnitTests/TracerProcessor.cs" />
    <Compile Remove="ResultProcessorUnitTests/TrackSubscriptions.cs" />
    <Compile Remove="ResultProcessorUnitTests/VectorSet.cs" />
    <Compile Remove="RoundTripUnitTests/**" />
    <!-- byte-parity against the old writer, which is gone: to become golden-byte tests, captured from the last build that had it -->
    <!-- retry categories of the old RedisDatabase messages: to assert the same categories on the new surface's frames -->
    <Compile Remove="CommandRetryCategoryUnitTests.cs" />
    <!-- drive ResultBox and RedisDatabase through a Message: to drive the same paths through the new core -->
    <Compile Remove="ResultBoxTests.cs" />
    <Compile Remove="SortedSetIncrementUnitTests.cs" />
    <!-- byte-parity of ValueCondition/Expiration against the old writer: golden bytes, as the parity tests -->
    <Compile Remove="InterpolatedOptionalArgTests.cs" />
    <!-- DedicatedThreads is not implemented by the new core (plan decision 6): to come back with it -->
    <Compile Remove="DedicatedThreadsUnitTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="*.json" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="*Config.json" />
    <None Update="redislabs_ca.pem" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Certificates\*.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ResultProcessorUnitTests.*.cs" DependentUpon="ResultProcessorUnitTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis\StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\toys\StackExchange.Redis.Server\StackExchange.Redis.Server.csproj" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" />
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.v3.runner.console" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="System.IO.Compression" />
    <PackageReference Include="System.IO.Pipelines" />
    <ProjectReference Include="..\..\src\RESPite\RESPite.csproj" />
    <ProjectReference Include="..\RESPite.Tests\RESPite.Tests.csproj" />
    <!-- to deal with package security warning -->
    <PackageReference Include="System.Private.Uri" />
  </ItemGroup>
</Project>
