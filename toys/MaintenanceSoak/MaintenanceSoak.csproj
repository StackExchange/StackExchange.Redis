<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>StackExchange.Redis.MaintenanceSoak</AssemblyName>
    <!-- the library is strong-named, so friend access needs a matching identity -->
    <SignAssembly>true</SignAssembly>
    <!-- consumes an [Experimental] surface on purpose; that is the point of the tool -->
    <!-- SER010: the maintenance surface, consumed on purpose. StringToRedisValue: the implicit string
         conversion, which is fine for a soak generating throwaway values. -->
    <NoWarn>$(NoWarn);SER010;StringToRedisValue</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis\StackExchange.Redis.csproj" />
    <ProjectReference Include="..\StackExchange.Redis.Server\StackExchange.Redis.Server.csproj" />
  </ItemGroup>

</Project>
