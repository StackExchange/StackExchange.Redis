<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>StackExchange.Redis.MaintenanceSoak</AssemblyName>
    <!-- the library is strong-named, so friend access needs a matching identity -->
    <SignAssembly>true</SignAssembly>
    <!-- StringToRedisValue: the implicit string conversion, which is fine for a soak generating
         throwaway values. -->
    <NoWarn>$(NoWarn);StringToRedisValue</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis\StackExchange.Redis.csproj" />
    <ProjectReference Include="..\StackExchange.Redis.Server\StackExchange.Redis.Server.csproj" />
  </ItemGroup>

</Project>
