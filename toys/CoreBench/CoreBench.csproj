<Project Sdk="Microsoft.NET.Sdk">

  <!-- The four-arm comparison from the queue: old core vs new core, single-threaded and contended.
       See readme.md for what each arm does and, more importantly, what the new arm still omits. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- the libraries are strong-named, so a friend assembly has to be signed too -->
    <SignAssembly>true</SignAssembly>
      <!-- a benchmark writing string payloads; the Debug-only self-check does not apply (see docs/exp/StringToRedisValue.md) -->
    <NoWarn>$(NoWarn);StringToRedisValue</NoWarn>
</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StackExchange.Redis\StackExchange.Redis.csproj" />
    <ProjectReference Include="..\..\src\RESPite\RESPite.csproj" />
  </ItemGroup>

</Project>
