<Project>
  <ItemGroup>
    <!-- Packages we depend on for StackExchange.Redis, upgrades can create binding redirect pain! -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.13" />
    <PackageVersion Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <!-- note that this bumps System.Buffers, so is pinned in down-level in SE csproj -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <!-- for RESPite -->
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <!-- For analyzers. This is no longer just "us": StackExchange.Redis.Build ships inside the
         StackExchange.Redis package, and an analyzer cannot load in a Roslyn host older than the version it
         was built against - so this is the oldest consumer tooling we support (4.3 = SDK 6.0.4xx / VS 17.3),
         not the newest we build with. It is a *compile-time* floor only: forward compatibility means the
         analyzer still loads in newer hosts, and at run-time the host's compiler may hand us values that
         post-date this version (see RoslynShims.cs - prefer a shim there over raising this).
         4.3 is where ForAttributeWithMetadataName arrives, and the generators need that to stay cheap on
         consumer code, so going lower is not useful. Raising it drops consumer tooling; do so deliberately. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
    <!-- The release-tracking analyzer (RS2002 etc), which the above would otherwise pull in transitively at
         3.3.3 - a version that cannot see descriptors declared outside the analyzer type, as ours are in
         Diagnostics.cs. Pinned separately because it is a build-time analyzer we never ship: unlike the
         reference above, its version has nothing to do with the host floor, so upgrade at will. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Packages only used in the solution, upgrade at will -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <!-- analyzer test harness; deliberately newer Roslyn than the shipped floor above (the harness needs it,
         and we cannot test at 4.3 without pinning the whole world) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- lifts the transitive 9.0.6 that NuGet.Packaging (via the testing harness) brings in, which NuGet audit flags -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- StackExchange.Redis.CodeFixes overrides this down to the shipped floor (4.3.0); the version here is
         the one the test harness needs, exactly as for the analyzer reference above -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <!-- the platform's own TRX reporter (the report-trx switch); xunit's own report-xunit-trx truncated a 400KB report in 4.0.2 -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- the current shipped v3: what the *Baseline projects and RESPite.Benchmark (TargetVer=3) compare against -->
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <PackageVersion Include="StackExchange.Redis.StrongName" Version="1.2.6" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" /> <!-- held at the v4 pin for the main merge; the 1.3 bump (main #3296) is its own step, since 1.3 has never seen v4-only code -->
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.13" />
    <PackageVersion Include="System.Reflection.Metadata" Version="10.0.13" />
    <!-- For binding redirect testing, main package gets this transitively -->
    <PackageVersion Include="System.Runtime.Caching" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
  </ItemGroup>
</Project>