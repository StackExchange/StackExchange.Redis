<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- No VersionOverride: this is the shipped analyzer, so it builds at the low floor pinned in
         Directory.Packages.props. Anything newer Roslyn offers goes in RoslynShims.cs. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- build-time only; overrides the 3.3.3 the above brings transitively (see Directory.Packages.props) -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- release tracking for the diagnostics we report; the analyzer equivalent of PublicAPI.*.txt -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RESPite\Shared\AsciiHash.cs">
      <Link>Shared/AsciiHash.cs</Link>
    </Compile>
    <Compile Include="..\..\src\RESPite\Shared\Experiments.cs">
      <Link>Shared/Experiments.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
