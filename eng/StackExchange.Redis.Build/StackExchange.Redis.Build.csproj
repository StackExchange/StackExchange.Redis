<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- This assembly ships inside the StackExchange.Redis package as an analyzer, and an analyzer cannot load
         in a Roslyn host older than the version it was built against. The rest of the repo tracks current
         Roslyn, but pinning *this* project low keeps the shipped analyzer loadable on older SDKs; forward
         compatibility means it still loads fine in the newer host we build with. ForAttributeWithMetadataName
         (which the generators rely on to stay cheap on consumer code) needs 4.3, so 4.8 leaves headroom (and RefKind.RefReadOnlyParameter, used below, needs 4.8).
         Raising this floor drops support for older consumer tooling - do it deliberately. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- release tracking for the diagnostics we report; the analyzer equivalent of PublicAPI.*.txt -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RESPite\Shared\AsciiHash.cs">
      <Link>Shared/AsciiHash.cs</Link>
    </Compile>
    <Compile Include="..\..\src\RESPite\Shared\Experiments.cs">
      <Link>Shared/Experiments.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
