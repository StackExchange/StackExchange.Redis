<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- extend the default lib targets for the main lib; mostly because of "vectors" -->
    <TargetFrameworks>net461;netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>

    <!--
      DISCOVERY ONLY - .NET 11 runtime-native async. Opt IN with /p:IncludePreviewTargets=true; never on
      by default, and forced off while packing, because a package that carries a TFM built against a
      preview runtime cannot ship as a non-preview release. The opt-in is what keeps the merge date from
      mattering: the target simply is not there unless somebody asks for it.

      Two knobs are needed, and NEITHER works alone - verified on clean builds, because an incremental
      one will happily report success from a stale obj/. The <Features> flag below, and the assembly
      attribute in RuntimeAsync.cs.
      The Packing test is part of the SAME condition, deliberately: trying to force it by assigning
      IncludePreviewTargets=false in a PropertyGroup does NOT work, because /p:IncludePreviewTargets=true
      is a global property and a project-level assignment cannot override one. That was tried, looked
      right, and put net11.0 in the .nupkg - so the gate is expressed where it cannot be outvoted.
    -->
    <TargetFrameworks Condition="'$(IncludePreviewTargets)' == 'true' and '$(Packing)' != 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <Description>High performance Redis client, incorporating both synchronous and asynchronous usage.</Description>
    <AssemblyName>StackExchange.Redis</AssemblyName>
    <AssemblyTitle>StackExchange.Redis</AssemblyTitle>
    <PackageId>StackExchange.Redis</PackageId>
    <PackageTags>Async;Redis;Cache;PubSub;Messaging</PackageTags>
    <SignAssembly>true</SignAssembly>
    <DefineConstants Condition="'$(TargetFramework)' != 'net461'">$(DefineConstants);VECTOR_SAFE</DefineConstants>

    <!-- see the IncludePreviewTargets note above; this is half the opt-in, RuntimeAsync.cs is the other -->
    <Features Condition="'$(TargetFramework)' == 'net11.0' and '$(DisableRuntimeAsync)' != 'true'">runtime-async=on</Features>
    <DefineConstants Condition="'$(TargetFramework)' != 'net461' and '$(TargetFramework)' != 'net472' and '$(TargetFramework)' != 'netstandard2.0'">$(DefineConstants);UNIX_SOCKET</DefineConstants>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- for debugging low-level parsing problems; absolutely do not us in production -->
    <!--<DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);PARSE_DETAIL</DefineConstants>-->
  
    <!-- SER352 reports how much of TransitionalDatabase is still generated throwing stubs. It is meant to
         be seen on every Release build, but the repo builds with TreatWarningsAsErrors, which would make it
         fatal and block the very work it is tracking. So: loud, not fatal, for as long as the transition
         runs. Delete this line to make shipping an incomplete TransitionalDatabase impossible; the warning
         disappears by itself when the count reaches zero. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SER352</WarningsNotAsErrors>
</PropertyGroup>

  <!-- /p:DisableRuntimeAsync=true builds the net11.0 target WITHOUT runtime async: the control column -->
  <ItemGroup Condition="'$(DisableRuntimeAsync)' == 'true'">
    <Compile Remove="RuntimeAsync.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- needed everywhere -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Hashing" />

    <!-- pipelines is built in from .NET 10 onwards -->
    <PackageReference Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" Include="System.IO.Pipelines"/>

    <!-- built into .NET core now -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Threading.Channels" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'netstandard2.0'" />

    <!-- net461 needs this for OSPlatform et al -->
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Condition="'$(TargetFramework)' == 'net461' " />
    
    <!-- netfx needs this for ZipArchive -->
    <PackageReference Include="System.IO.Compression" Condition="'$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net461' " />

    <None Include="README.md" Pack="true" PackagePath="\"/>

    <!-- imported into consuming projects; makes <RedisMinServerVersion> visible to the shipped analyzer -->
    <None Include="build\StackExchange.Redis.props" Pack="true" PackagePath="build\" />

    <Compile Update="BitFieldOperation.*.cs" DependentUpon="BitFieldOperation.cs" />
    <Compile Update="HotKeys.*.cs" DependentUpon="HotKeys.cs" />
    <Compile Update="RedisValue.*.cs" DependentUpon="RedisValue.cs" />
    <Compile Update="ServerEndPoint.*.cs" DependentUpon="ServerEndPoint.cs" />
    <Compile Update="Groups\Arrays.*.cs" DependentUpon="Arrays.cs" />
    <Compile Update="Groups\Bitmaps.*.cs" DependentUpon="Bitmaps.cs" />
    <Compile Update="Groups\Geospatial.*.cs" DependentUpon="Geospatial.cs" />
    <Compile Update="Groups\Hashes.*.cs" DependentUpon="Hashes.cs" />
    <Compile Update="Groups\HyperLogLog.*.cs" DependentUpon="HyperLogLog.cs" />
    <Compile Update="Groups\Keys.*.cs" DependentUpon="Keys.cs" />
    <Compile Update="Groups\Lists.*.cs" DependentUpon="Lists.cs" />
    <Compile Update="Groups\Scripts.*.cs" DependentUpon="Scripts.cs" />
    <Compile Update="Groups\Sets.*.cs" DependentUpon="Sets.cs" />
    <Compile Update="Groups\SortedSets.*.cs" DependentUpon="SortedSets.cs" />
    <Compile Update="Groups\Streams.*.cs" DependentUpon="Streams.cs" />
    <Compile Update="Groups\Strings.*.cs" DependentUpon="Strings.cs" />
    <Compile Update="Groups\VectorSets.*.cs" DependentUpon="VectorSets.cs" />
    <Compile Update="Transitional\TransitionalDatabase.*.cs" DependentUpon="TransitionalDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- APIs for all target frameworks -->
    <AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
    <!-- conditional symbol entries (debug hacks) -->
    <AdditionalFiles Include="PublicAPI/$(Configuration)/PublicAPI.txt" />
    <!-- progressively additive APIs in later frameworks; each folder is effectively NET_X_Y_OR_GREATER -->
    <AdditionalFiles Include="PublicAPI/net6.0/PublicAPI.*.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))" />
    <!-- for example... -->
    <!-- <AdditionalFiles Include="PublicAPI/net10.0/PublicAPI.*.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" /> -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StackExchange.Redis.Benchmarks" />
    <InternalsVisibleTo Include="CoreBench" />
    <InternalsVisibleTo Include="StackExchange.Redis.Server" />
    <InternalsVisibleTo Include="StackExchange.Redis.Tests" />
    <InternalsVisibleTo Include="StackExchange.Redis.FaultInjector.Tests" />
    <!-- the soak asserts on internal state: relaxed windows, the dedup ring, handoff flags -->
    <InternalsVisibleTo Include="StackExchange.Redis.MaintenanceSoak" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RESPite\RESPite.csproj" />
  </ItemGroup>

  <!--
    Ship eng/StackExchange.Redis.Build as the package's analyzer, and eng/StackExchange.Redis.CodeFixes
    alongside it. Every project already references the analyzer (see Directory.Build.props) with
    ReferenceOutputAssembly="false", so it is a build-time tool here and not a dependency; this is what
    additionally puts it in the package for consumers.

    analyzers/dotnet/cs is the conventional path, and applies to all consumer target frameworks. Roslyn itself
    is PrivateAssets="all" in both projects so it is not carried along - the host supplies it. That is also why
    the code fixes are a *separate* assembly: they need Workspaces, which csc does not ship and the IDE does.

    The paths are asked of the projects rather than assembled from bin/$(Configuration), so that a change to the
    output layout cannot quietly produce a package with no analyzer in it. The existence check is the point:
    Packing without having built them is otherwise a silent omission, and the failure mode downstream
    (no diagnostics, ever, for any consumer) is invisible.
  -->
  <Target Name="_ResolveSERAnalyzerForPackaging" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\..\eng\StackExchange.Redis.Build\StackExchange.Redis.Build.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SERAnalyzerAssembly" />
    </MSBuild>

    <!-- appended to the same item, so the checks and the pack below cover both without being written twice -->
    <MSBuild Projects="..\..\eng\StackExchange.Redis.CodeFixes\StackExchange.Redis.CodeFixes.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_SERAnalyzerAssembly" />
    </MSBuild>

    <Error Condition="'@(_SERAnalyzerAssembly)' == ''"
           Text="Could not resolve the StackExchange.Redis.Build analyzer output; the package would ship without its analyzer." />
    <Error Condition="!Exists('%(_SERAnalyzerAssembly.FullPath)')"
           Text="The StackExchange.Redis.Build analyzer has not been built (%(_SERAnalyzerAssembly.FullPath)); build it before packing." />

    <ItemGroup>
      <!-- no trailing separator: these items are absolute paths, and NuGet appends one itself - a trailing
           slash here produces "analyzers/dotnet/cs//Foo.dll", which loads but is a malformed package path -->
      <None Include="@(_SERAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Update="Availability/MultiGroupDatabase.*.cs">
      <DependentUpon>MultiGroupDatabase.cs</DependentUpon>
    </Compile>
    <Compile Update="Availability/HealthCheck.*.cs">
      <DependentUpon>HealthCheck.cs</DependentUpon>
    </Compile>
    <Compile Update="Availability/HealthCheckProbe.*.cs">
      <DependentUpon>HealthCheckProbe.cs</DependentUpon>
    </Compile>
    <Compile Update="Availability/MultiGroupSubscriber.*.cs">
      <DependentUpon>MultiGroupSubscriber.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>